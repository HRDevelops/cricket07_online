# ==============================================================================
# Cricket 07 Online - .gitignore
# Enforcing Rule 1: "Bring Your Own Game" (BYOG) - Zero copyrighted assets
# ==============================================================================

# Game Binaries, Archives & Audio (EA Sports Cricket 07 Copyrighted Data)
*.exe
*.dll
*.iso
*.bin
*.cue
*.gob
*.viv
*.big
*.fsh
*.asf
*.vp6
*.mad
*.wav
*.mp3
*.ogg
Audio/
audio/
Data/
data/
root/
games/
functions.json

# Ghidra Projects, Locks, and Database Files
ghidra_project/
*.rep/
*.gpr
*.lock
*.lock~
*.bundle/

# Build & Intermediate Output Directories
work/
build/
build_web/
dist/
out_all/
out_trace/
tests/results/
third_party/
userdata/
*.o
*.obj
*.wasm
*.dSYM/

# Allow web runtime build artifacts
!web/build/
!web/build/**
!web/build/*.wasm

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
*.egg-info/

# Local Environment Variables, Secrets & Wrangler Config
.env
.env.*
!.env.example
.dev.vars
wrangler.local.json
.wrangler/
*.pem
*.key
*.cert

# Operating System & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/
*.swp
*~
